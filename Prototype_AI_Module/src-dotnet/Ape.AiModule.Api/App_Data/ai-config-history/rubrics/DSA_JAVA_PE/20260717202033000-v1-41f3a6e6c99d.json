                                                                   "solution_code":  [
                                                                                         {
                                                                                             "filename":  "Main.java",
                                                                                             "content":  "import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[] arr = new int[n];\n\n        for (int i = 0; i \u003c n; i++) {\n            arr[i] = sc.nextInt();\n        }\n\n        for (int i = 0; i \u003c n; i++) {\n            for (int j = i + 1; j \u003c n; j++) {\n                if (arr[i] == arr[j]) {\n                    System.out.println(arr[i]);\n                    return;\n                }\n            }\n        }\n\n        System.out.println(-1);\n    }\n}"
                                                                                         }
