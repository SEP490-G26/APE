                                                                                             "filename":  "Main.java",
                                                                                             "content":  "import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[] arr = new int[n];\n        int count = 0;\n\n        for (int i = 0; i \u003c n; i++) {\n            arr[i] = sc.nextInt();\n            if (arr[i] % 2 == 0) {\n                count++;\n            }\n        }\n\n        System.out.println(count);\n    }\n}"
