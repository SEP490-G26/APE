PORT=3001
OPENAI_API_KEY=your_openai_api_key
# Optional: OpenAI-compatible endpoint/proxy, e.g. https://your-endpoint/v1
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
# Optional cost config for report (USD per 1M input tokens)
COHERE_EMBED_INPUT_PER_1M=0
GEMINI_API_KEY=your_gemini_api_key
# Recommended default after Gemini 1.5 EoS:
GEMINI_MODEL=gemini-3.5-flash
# Alternative:
# GEMINI_MODEL=gemini-3.1-flash
