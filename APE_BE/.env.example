# ==============================================================================
# APE (AI-Powered Examination and Programming Practice Platform) — Environment Configuration
# Copy this file to .env and replace placeholder values with your real credentials.
# NOTE: .env is for local development only and must NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection
# ------------------------------------------------------------------------------
# Local MongoDB instance:
ConnectionStrings__MongoDb=mongodb://localhost:27017/APE_DB
# Or MongoDB Atlas Cloud:
# ConnectionStrings__MongoDb=mongodb+srv://<username>:<password>@cluster.mongodb.net/APE_DB

DatabaseName=APE_DB
Database__RunSeedOnStartup=true

# ------------------------------------------------------------------------------
# 2. JWT Authentication Settings
# ------------------------------------------------------------------------------
JwtSettings__Secret=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_HERE
JwtSettings__Issuer=APE_Backend
JwtSettings__Audience=APE_Frontend
JwtSettings__AccessTokenExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=7

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Identity Services
# ------------------------------------------------------------------------------
GoogleAuth__ClientId=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. AI Provider 1: OpenAI (Primary Generator & OCR Vision)
# ------------------------------------------------------------------------------
AIProviders__OpenAI__Enabled=true
AIProviders__OpenAI__ApiKey=your_openai_api_key_here
AIProviders__OpenAI__BaseUrl=https://api.openai.com/v1
AIProviders__OpenAI__ApiVersion=v1
AIProviders__OpenAI__DefaultTextModel=gpt-4o
AIProviders__OpenAI__DefaultVisionModel=gpt-4o
AIProviders__OpenAI__DefaultEmbeddingModel=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. AI Provider 2: DeepSeek (Safety Gatekeeper & Auto-Fallback Generator)
# ------------------------------------------------------------------------------
AIProviders__DeepSeek__Enabled=true
AIProviders__DeepSeek__ApiKey=your_deepseek_api_key_here
AIProviders__DeepSeek__BaseUrl=https://api.deepseek.com
AIProviders__DeepSeek__ApiVersion=v1
AIProviders__DeepSeek__DefaultTextModel=deepseek-v4-flash

# ------------------------------------------------------------------------------
# 6. AI Provider 3: Google Gemini (Alternative Multimodal Provider)
# ------------------------------------------------------------------------------
AIProviders__Gemini__Enabled=true
AIProviders__Gemini__ApiKey=your_gemini_api_key_here
AIProviders__Gemini__BaseUrl=https://generativelanguage.googleapis.com/
AIProviders__Gemini__ApiVersion=v1beta
AIProviders__Gemini__DefaultTextModel=gemini-2.5-flash
AIProviders__Gemini__DefaultVisionModel=gemini-2.5-flash
AIProviders__Gemini__DefaultEmbeddingModel=gemini-embedding-001

# ------------------------------------------------------------------------------
# 7. AI Provider 4: Cohere (Multilingual Vector Embeddings 1024-dim)
# ------------------------------------------------------------------------------
AIProviders__Cohere__Enabled=true
AIProviders__Cohere__ApiKey=your_cohere_api_key_here
AIProviders__Cohere__BaseUrl=https://api.cohere.com/
AIProviders__Cohere__ApiVersion=v1
AIProviders__Cohere__DefaultTextModel=command-r7b-12-2024
AIProviders__Cohere__DefaultEmbeddingModel=embed-multilingual-v3.0

# ------------------------------------------------------------------------------
# 8. Judge0 CE Code Execution Sandbox
# ------------------------------------------------------------------------------
Judge0__BaseUrl=https://judge0-ce.p.rapidapi.com/
Judge0__AuthenticationMode=RapidApi
Judge0__RapidApiKey=your_rapidapi_key_here
Judge0__RapidApiHost=judge0-ce.p.rapidapi.com
Judge0__TimeoutSeconds=30
Judge0__MaximumBatchSize=100
Judge0__MaximumSourceFiles=20
Judge0__MaximumArchiveBytes=5242880
Judge0__MultiFileLanguageId=89

# ------------------------------------------------------------------------------
# 9. PayOS Payment Gateway (VietQR)
# ------------------------------------------------------------------------------
PayOS__ClientId=your_payos_client_id_here
PayOS__ApiKey=your_payos_api_key_here
PayOS__ChecksumKey=your_payos_checksum_key_here
PayOS__ReturnUrl=http://localhost:5173/purchase/history/
PayOS__CancelUrl=http://localhost:5173/wallet/top-up/

# ------------------------------------------------------------------------------
# 10. Azure Blob Storage (Document Persistence)
# ------------------------------------------------------------------------------
AzureBlobStorage__ConnectionString=your_azure_storage_connection_string_here
AzureBlobStorage__ContainerName=ape-documents
AzureBlobStorage__DocumentsPrefix=uploads/documents
