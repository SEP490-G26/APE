{
  "dataset_version": "dataset_v1",
  "created_at": "2026-06-25",
  "scope": {
    "languages": ["C", "Java_OOP", "DSA_OOP"],
    "supported_file_types": [
      "doc",
      "docx",
      "xlsx",
      "xls",
      "pptx",
      "ppt",
      "pdf",
      "png",
      "jpg",
      "jpeg",
      "webp",
      "gif",
      "txt",
      "md"
    ]
  },
  "datasets": [
    {
      "id": "dataset_gatekeeper",
      "file": "dataset_gatekeeper.json",
      "purpose": "Classify supported vs unsupported content domain",
      "primary_metrics": ["accuracy", "f1", "false_positive_rate", "false_negative_rate"]
    },
    {
      "id": "dataset_ingestion_vision_embedding",
      "file": "dataset_ingestion_vision_embedding.json",
      "purpose": "Benchmark parse/vision/chunk/embed pipeline by file type",
      "primary_metrics": ["parse_success_rate", "ocr_quality_score", "recall_at_k", "latency_ms", "cost_usd"]
    },
    {
      "id": "dataset_multiagent_gen_review",
      "file": "dataset_multiagent_gen_review.json",
      "purpose": "Benchmark FE/PE generation and reviewer decisions",
      "primary_metrics": ["schema_valid_rate", "factual_score", "difficulty_alignment", "review_decision_accuracy", "regen_count"]
    },
    {
      "id": "dataset_code_mentor",
      "file": "dataset_code_mentor.json",
      "purpose": "Benchmark code diagnosis and feedback quality",
      "primary_metrics": ["major_bug_detection_rate", "fix_usefulness_score", "complexity_accuracy", "policy_compliance"]
    }
  ],
  "evaluation_policy": {
    "fixed_core_set": true,
    "difficulty_distribution_target": {
      "easy": 0.3,
      "medium": 0.4,
      "hard": 0.3
    },
    "domain_distribution_target": {
      "C": 0.35,
      "Java_OOP": 0.35,
      "DSA_OOP": 0.3
    }
  }
}
